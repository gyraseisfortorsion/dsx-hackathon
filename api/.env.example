API_PASSWORD=replace-with-your-shared-prototype-password
LLM_MODEL=google:gemini-3.8-flash
GOOGLE_API_KEY=
# Chat history needs a writable local directory. Run a single Uvicorn worker.
HISTORY_DIR=runtime/messages
# Comma-separated browser origins, if a frontend needs CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Vercel: use private Blob JSON history instead of the local filesystem.
HISTORY_BACKEND=file
BLOB_STORE_ID=
# Optional outside Vercel; deployed functions get automatic storage credentials.
BLOB_READ_WRITE_TOKEN=
# On Vercel, LLM_MODEL=vercel:google/gemini-3.8-flash uses AI Gateway/OIDC.

# Community demo only: allowlist stands in for university identity verification.
COMMUNITY_VERIFIED_USERS=alex,maya,jordan,sam,taylor
# Separate credential, required in X-Moderator-Token for moderation/aggregate metrics.
COMMUNITY_MODERATOR_TOKEN=
STUDY_MIN_OVERLAP_MINUTES=30
STUDY_OVERLAP_TARGET_MINUTES=180
MARKETPLACE_EXPIRY_DAYS=30
COMMUNITY_INVITATIONS_PER_HOUR=20
COMMUNITY_LISTINGS_PER_HOUR=10
COMMUNITY_MESSAGES_PER_HOUR=120
# Experimental synthetic-trained model flags. Never automatically remove or ban.
COMMUNITY_ML_REVIEW_ENABLED=false
