API_PASSWORD=replace-with-your-shared-prototype-password
LLM_MODEL=google:gemini-3.8-flash
GOOGLE_API_KEY=
# Chat history needs a writable local directory. Run a single Uvicorn worker.
HISTORY_DIR=runtime/messages
# Comma-separated browser origins, if a frontend needs CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Vercel: use private Blob JSON history instead of the local filesystem.
HISTORY_BACKEND=file
BLOB_STORE_ID=
# Optional outside Vercel; deployed functions get automatic storage credentials.
BLOB_READ_WRITE_TOKEN=
# On Vercel, LLM_MODEL=vercel:google/gemini-3.8-flash uses AI Gateway/OIDC.
